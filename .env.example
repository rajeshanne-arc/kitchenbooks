# Required server-side values
DATABASE_URL=
# Keep TLS enabled in every deployed environment. Set only for a local
# Unix-socket acceptance database if that database does not provide TLS.
# KB_DB_SSL=disable
KB_SESSION_SECRET=

# Only needed for the one-time local bootstrap flow; remove after setup.
KB_PIN=

# Local demo POS adapter. Set false or remove when using configured Petpooja.
PETPOOJA_DEMO=true

# Optional production capabilities; never expose these to the browser.
# KB_MEMBERSHIPS=false
# KB_PLATFORM_ADMIN_KEY=
# Demo-only hosted visualization environment. Never point this at a real
# restaurant tenant. The reset endpoint is called by the midnight systemd timer.
# KB_DEMO_TENANT_ID=
# KB_DEMO_OWNER_USERNAME=sunny
# KB_DEMO_RESET_SECRET=
# KB_POS_CREDENTIALS_KEY=
# CRON_SECRET=
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
# Self-hosted private attachment storage (absolute directory, mode 0700).
# Replace with R2 or Vercel Blob later without changing attachment records.
# KB_FILE_STORAGE_DIR=
